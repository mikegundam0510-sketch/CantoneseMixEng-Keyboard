+package hk.cantonesemixeng.keyboard;
+
+import java.io.*;
+import java.util.*;
+import java.util.function.ToIntFunction;
+
+/** Optional residual for omitted tail alternatives; the established first five stay intact. */
+public final class TailRecoveryRanker {
+    private final PhraseRelationRanker model;
+    private TailRecoveryRanker(PhraseRelationRanker model){this.model=model;}
+    public static TailRecoveryRanker load(InputStream encoded)throws IOException {
+        PhraseRelationRanker model=PhraseRelationRanker.load(encoded);
+        if(model.aligned())throw new IOException("Unsupported tail recovery model");
+        return new TailRecoveryRanker(model);
+    }
+    void recover(String context,List<String> values,Map<String,Double> scores,ToIntFunction<String> personal) {
+        if(scores==null||values.size()<=20)return;
+        String boundary=values.get(19);double floor=scores.get(boundary);
+        Map<String,Map<String,Integer>> cache=new HashMap<>();
+        double reference=model.rawScore(context,boundary,cache);
+        PhraseRelationRanker.Evidence boundaryEvidence=null;
+        Map<String,Double> promotedScores=new HashMap<>();List<String> eligible=new ArrayList<>();
+        for(String value:values.subList(20,Math.min(36,values.size()))) {
+            double raw=model.rawScore(context,value,cache),lift=raw-reference;
+            double correction=model.alignedCorrection(raw,reference),score=scores.get(value)+correction;
+            if(lift<.5||correction<=0||score<floor+.5)continue;
+            if(boundaryEvidence==null)boundaryEvidence=model.cachedEvidence(context,boundary,cache);
+            if(!model.cachedEvidence(context,value,cache).supportedOver(boundaryEvidence))continue;
+            promotedScores.put(value,score);eligible.add(value);
+        }
+        eligible.sort(Comparator.comparingDouble((String value)->promotedScores.get(value)).reversed());
+        if(eligible.size()>2)eligible=new ArrayList<>(eligible.subList(0,2));
+        if(eligible.isEmpty())return;
+        List<String> tail=new ArrayList<>(values.subList(5,20));tail.addAll(eligible);
+        tail.sort(Comparator.comparingInt(personal).reversed().thenComparing(
+            Comparator.comparingDouble((String value)->promotedScores.getOrDefault(value,scores.get(value))).reversed()));
+        List<String> reordered=new ArrayList<>(values.subList(0,5));reordered.addAll(tail.subList(0,15));
+        Set<String> seen=new HashSet<>(reordered);for(String value:values)if(seen.add(value))reordered.add(value);
+        values.clear();values.addAll(reordered);
+    }
+}
