+package hk.cantonesemixeng.keyboard;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+import java.util.zip.GZIPOutputStream;
+
+public class TailRecoveryRankerTest {
+    private static Reader asset(String name)throws IOException {
+        return new InputStreamReader(new FileInputStream("src/main/assets/"+name),StandardCharsets.UTF_8);
+    }
+    private static QuickDecoder decoder(DictionaryEngine dictionary,TailRecoveryRanker tail)throws IOException {
+        return new QuickDecoder(dictionary,asset("quick_phrases.tsv"),asset("hk_phrases.tsv"),asset("cantonese_phrases.tsv"),
+            OfflineLanguageModel.load(new FileInputStream("src/main/assets/language_model.b64")),
+            PhraseLanguageModel.load(new FileInputStream("src/main/assets/phrase_model.b64")),asset("hk_chat_phrases.tsv"),
+            CandidateRanker.load(new FileInputStream("src/main/assets/candidate_ranker.b64")),
+            CandidateRanker.loadWords(new FileInputStream("src/main/assets/word_ranker.b64")),
+            SentenceRanker.load(new FileInputStream("src/main/assets/sentence_ranker.b64")),
+            PrefixRanker.load(new FileInputStream("src/main/assets/prefix_ranker.b64")),
+            PhraseRelationRanker.load(new FileInputStream("src/main/assets/relation_ranker.b64")),tail);
+    }
+    @Test public void bundledModelRecoversAnExactSentenceWithoutChangingTheFirstFive()throws Exception {
+        DictionaryEngine dictionary=new DictionaryEngine(asset("cangjie5.base.dict.yaml"),asset("english.txt"),asset("character_frequencies.tsv"));
+        QuickDecoder before=decoder(dictionary,null),after=decoder(dictionary,TailRecoveryRanker.load(new FileInputStream("src/main/assets/tail_ranker.b64")));
+        // Evaluation-only public words.hk example; tools/data/phrase_relations/NOTICE.md.
+        String code="ofkbpnrnkgpvggpcucujloajeqiofrd",gold="你有乜嘢雄心壯志爸爸都會支持你㗎";
+        List<String> old=before.decode(code,(c,w)->0),values=after.decode(code,(c,w)->0);
+        assertFalse(old.contains(gold));assertEquals(8,values.indexOf(gold)+1);
+        assertEquals(old.subList(0,5),values.subList(0,5));assertTrue(values.size()<=20);
+        assertEquals(values.size(),new HashSet<>(values).size());
+        for(String value:values)assertFalse(dictionary.matchQuickCodes(code,value).isEmpty());
+    }
+    private static TailRecoveryRanker fixture(float strength)throws IOException {
+        ByteArrayOutputStream bytes=new ByteArrayOutputStream();
+        try(DataOutputStream out=new DataOutputStream(new GZIPOutputStream(bytes))) {
+            out.writeInt(0x50525231);out.writeInt(2);out.writeInt(2);out.writeFloat(strength);out.writeFloat(2);
+            for(String[] item:new String[][]{{"交","V"},{"功課","N"}}) {
+                byte[] raw=item[0].getBytes(StandardCharsets.UTF_8);out.writeShort(raw.length);out.write(raw);out.writeByte(item[1].charAt(0));out.writeShort(10);
+            }
+            for(String key:Arrays.asList("SV|你|交","VQ|交|Y")) {
+                byte[] raw=key.getBytes(StandardCharsets.UTF_8);out.writeShort(raw.length);out.write(raw);out.writeFloat(1);
+            }
+        }
+        return TailRecoveryRanker.load(new ByteArrayInputStream(Base64.getEncoder().encode(bytes.toByteArray())));
+    }
+    private static List<String> original() {
+        List<String> values=new ArrayList<>();for(int i=0;i<20;i++)values.add("占"+(char)(0x4E00+i));return values;
+    }
+    private static Map<String,Double> scores(List<String> values) {
+        Map<String,Double> result=new HashMap<>();for(int i=0;i<20;i++)result.put(values.get(i),20.0-i);
+        for(String value:values.subList(20,values.size()))result.put(value,.75);return result;
+    }
+    @Test public void evidenceGateRejectsSingleKindAndPreservesPersonalTailChoices()throws Exception {
+        List<String> original=original(),values=new ArrayList<>(original);
+        values.add("你交功課");Map<String,Double> scores=scores(values);List<String> unsupported=new ArrayList<>(values);
+        fixture(1.5f).recover("",values,scores,v->0);assertEquals(unsupported,values);
+        values.add("你交功課未");scores=scores(values);Map<String,Double> untouched=new HashMap<>(scores);
+        final String favorite=original.get(19);fixture(1.5f).recover("",values,scores,v->v.equals(favorite)?100:0);
+        assertEquals(original.subList(0,5),values.subList(0,5));assertEquals(favorite,values.get(5));
+        assertTrue(values.subList(0,20).contains("你交功課未"));assertFalse(values.subList(0,20).contains("你交功課"));
+        assertEquals(untouched,scores);assertEquals(values.size(),new HashSet<>(values).size());
+    }
+    @Test public void zeroStrengthAndCandidatesPastTheInspectionBoundLeaveTheListIntact()throws Exception {
+        List<String> values=original();values.add("你交功課未");List<String> old=new ArrayList<>(values);
+        fixture(0).recover("",values,scores(values),v->0);assertEquals(old,values);
+        values=original();for(int i=0;i<16;i++)values.add("未知"+(char)(0x4E00+i));values.add("你交功課未");old=new ArrayList<>(values);
+        fixture(1.5f).recover("",values,scores(values),v->0);assertEquals(old,values);
+    }
+    @Test public void wrongModelTypeAndCorruptEncodingAreRejectedForOptionalFallback()throws Exception {
+        try{TailRecoveryRanker.load(new FileInputStream("src/main/assets/relation_ranker.b64"));fail();}catch(IOException expected){}
+        try{TailRecoveryRanker.load(new ByteArrayInputStream(new byte[]{1,2,3}));fail();}catch(IOException expected){}
+    }
+}
